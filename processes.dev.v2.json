{
  "apps": [
    {
      "name": "apiv2-build",
      "script": "make",
      "args": "build",
      "cwd": "/app/apiv2",
      "watch": ["cmd", "internal"],
      "watch_options": {
        "followSymlinks": false
      },
      "autorestart": false
    },
    {
      "name": "apiv2",
      "script": "func",
      "args": "start",
      "cwd": "/app/apiv2",
      "interpreter": "none",
      "watch": ["bin/apiv2-handler"],
      "watch_options": {
        "followSymlinks": false
      }
    },
    {
      "name": "frontend",
      "script": "npm",
      "args": "run dev",
      "cwd": "/app/frontend"
    },
    {
      "name": "azurite",
      "script": "azurite",
      "args": "--silent --location /app/__azurite_db__",
      "cwd": "/app",
      "interpreter": "none"
    }
  ]
}
